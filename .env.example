# ==============================================================================
# HeritageLens AI Environment Configuration
# ==============================================================================

# 1. Google Gemini AI API Key (Required for monument identification & audio stories)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. TiDB Cloud Serverless MySQL (Persistent Cloud Database)
# Create a free cluster at: https://tidbcloud.com
TIDB_HOST="gateway01.ap-southeast-1.prod.aws.tidbcloud.com"
TIDB_PORT=4000
TIDB_USER="your_cluster_user.root"
TIDB_PASSWORD="your_tidb_password"
TIDB_DATABASE="test"
# Alternatively, provide full connection URL:
# DATABASE_URL="mysql://your_user:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?ssl={\"rejectUnauthorized\":true}"

# 3. Cloudinary (Cloud Image & Asset Hosting)
# Create a free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Or single CLOUDINARY_URL:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# 4. Server Port & Hosting
PORT=5000
NODE_ENV="production"
